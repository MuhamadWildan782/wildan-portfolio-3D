{
  "name": "wildan-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write src tests index.html eslint.config.js",
    "format:check": "prettier --check src tests index.html eslint.config.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "test:browser": "node tests/browser.mjs",
    "test:world": "node tests/world.browser.mjs"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
